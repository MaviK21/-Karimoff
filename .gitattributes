# =============================================
# Karimoff — .gitattributes
# =============================================
# Принудительный LF для deploy-скриптов, systemd-юнитов,
# nginx-конфигов и env-шаблонов.
# Windows (core.autocrlf=true) не будет их CRLF-ить.

# --- Shell / systemd / nginx / env ---
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf

# --- JS / CSS ---
*.js text
*.css text

# --- HTML ---
*.html text

# --- SVG / PNG / JPG ---
*.svg binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# --- Lock / DB / logs ---
package-lock.json text
*.db binary
*.db-shm binary
*.db-wal binary
*.log text eol=lf
