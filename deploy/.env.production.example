# Karimoff — production environment (Ubuntu 24.04 VPS)
# Скопировать в /opt/karimoff/.env и заполнить реальные значения.
# Права на файл: chmod 600, владелец karimoff.

# --- Приложение ---
# Порт внутреннего Node-сервера. Снаружи закрыт firewall'ом, nginx проксирует 127.0.0.1:3000.
PORT=3000

# Доверять X-Forwarded-For от nginx (ОБЯЗАТЕЛЬНО =1 за reverse proxy,
# иначе rate limits и admin lockout будут считать IP прокси, а не клиента).
TRUST_PROXY=1

# Пароль администратора (/admin). Минимум 12+ символов, генерировать: openssl rand -base64 18
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- SMTP (отправка заявок на почту) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=karimoff.by@gmail.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD

# --- Информационное ---
# Адрес для заявок фактический берётся из БД (Админ-панель -> Настройки заявок).
# Переменная оставлена для совместимости с текущим .env.
ORDERS_EMAIL=karimoff.by@gmail.com
