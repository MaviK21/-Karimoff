[Unit]
Description=Karimoff — разовый WAL-safe backup БД (запускается таймером karimoff-backup.timer)

[Service]
Type=oneshot
User=karimoff
Group=karimoff
WorkingDirectory=/opt/karimoff
# Безопасный снимок SQLite с учётом WAL (не требует остановки приложения).
ExecStart=/usr/bin/node -e "const Database=require('better-sqlite3');const db=new Database('karimoff.db',{readonly:true});db.backup('/var/backups/karimoff/karimoff-'+new Date().toISOString().replace(/[:.]/g,'-')+'.db').then(()=>{db.close();console.log('backup ok')}).catch(e=>{db.close();console.error(e);process.exit(1)})"
ExecStartPost=/bin/bash -c 'ls -1t /var/backups/karimoff/karimoff-*.db 2>/dev/null | tail -n +15 | xargs -r rm -f'
# Uploads is appended ONLY by karimoff-backup.service.d/90-uploads.conf.

# Hardening: запись только в /var/backups/karimoff (чтение БД — из /opt/karimoff).
# ProtectSystem=full монтирует read-only только /usr, /boot, /efi, /etc — поэтому
# чтение /opt/karimoff/uploads (источник снимка) и /opt/karimoff/karimoff.db
# разрешено без расширения ReadWritePaths. Записи идут в /var/backups/karimoff;
# flock берётся на каталог, отдельного lock-файла нет.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/backups/karimoff
# umask 0077: файлы копий БД, создаваемых node (db.backup()), получают 600 —
# иначе при стандартном umask 022 копия читалась бы всеми пользователями.
# Снимки uploads этим НЕ затронуты: uploads-backup.sh ЯВНО выставляет права
# chmod 750 (каталоги) и 640 (файлы) до публикации; внутри скрипта umask 077.
UMask=0077
